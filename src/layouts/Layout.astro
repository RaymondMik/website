---
import "../styles/global.css";
import "@fontsource-variable/archivo";
import "@fontsource-variable/source-serif-4";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";

interface Props {
  title?: string;
  description?: string;
  /** Open Graph type. Blog posts pass "article" to get article:* metadata. */
  type?: "website" | "article";
  /** Path to the social preview image, relative to the site root. */
  image?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
}

const {
  title,
  description = "Ramón Miklus, software engineer. Notes from building software.",
  type = "website",
  image = "/og.png",
  publishedTime,
  modifiedTime,
  tags = [],
} = Astro.props;

const siteName = "Ramón Miklus";
const authorName = "Ramón Miklus";
const authorEmail = "hello@ramonmiklus.com";

// Google Search Console verification (HTML-tag method). Leave empty if the
// property is verified via DNS instead.
const googleSiteVerification = "";

const social = [
  {
    label: "GitHub",
    href: "https://github.com/RaymondMik",
    icon: "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12",
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/ramon-miklus/",
    icon: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
  },
];

const pageTitle = title ? `${title} · ${siteName}` : siteName;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
const personId = new URL("/#person", Astro.site).href;
const isArticle = type === "article";

// Site-wide structured data: who runs this site and what it is. The Person
// node is referenced by id from BlogPosting markup on post pages.
const siteJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": new URL("/#website", Astro.site).href,
      url: Astro.site?.href,
      name: siteName,
      alternateName: "Ramon Miklus",
      description:
        "Personal notes and thoughts on software engineering by Ramón Miklus.",
      inLanguage: "en",
      publisher: { "@id": personId },
    },
    {
      "@type": "Person",
      "@id": personId,
      name: authorName,
      alternateName: "Ramon Miklus",
      givenName: "Ramón",
      familyName: "Miklus",
      jobTitle: "Software Engineer",
      description:
        "Software engineer based in Italy, building web platforms, mobile apps and cloud systems in TypeScript and Python.",
      url: Astro.site?.href,
      email: `mailto:${authorEmail}`,
      image: imageURL.href,
      worksFor: { "@type": "Organization", name: "Nagarro" },
      address: { "@type": "PostalAddress", addressCountry: "IT" },
      knowsAbout: [
        "Software engineering",
        "TypeScript",
        "Python",
        "Web development",
        "Cloud computing",
        "AI engineering",
      ],
      sameAs: social.map((s) => s.href),
    },
  ],
};

/** `aria-current` value for a top-level nav link, based on the current path. */
const current = (section: string) =>
  Astro.url.pathname.startsWith(section) ? "page" : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={authorName} />
    <link rel="canonical" href={canonicalURL} />
    {
      googleSiteVerification && (
        <meta name="google-site-verification" content={googleSiteVerification} />
      )
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f7f7f5" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#101216" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteName} — Writing`}
      href={new URL("rss.xml", Astro.site)}
    />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:alt" content={`${siteName} — ${title ?? "Notes from building software"}`} />
    {
      isArticle && (
        <>
          <meta property="article:author" content={new URL("/about/", Astro.site)} />
          {publishedTime && (
            <meta property="article:published_time" content={publishedTime.toISOString()} />
          )}
          {modifiedTime && (
            <meta property="article:modified_time" content={modifiedTime.toISOString()} />
          )}
          {tags.map((tag) => (
            <meta property="article:tag" content={tag} />
          ))}
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />
    <slot name="head" />
    <script is:inline>
      // Apply the saved theme before first paint to avoid a flash of the wrong palette.
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch {}
        const mq = matchMedia("(prefers-color-scheme: dark)");
        const apply = (t) => (document.documentElement.dataset.theme = t);
        apply(stored === "light" || stored === "dark" ? stored : mq.matches ? "dark" : "light");
        // Follow OS changes while the visitor has not picked a theme explicitly.
        mq.addEventListener("change", (e) => {
          let s = null;
          try {
            s = localStorage.getItem("theme");
          } catch {}
          if (s !== "light" && s !== "dark") apply(e.matches ? "dark" : "light");
        });
      })();
    </script>
  </head>
  <body
    class="bg-paper text-ink font-serif antialiased min-h-dvh flex flex-col"
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-paper focus:px-3 focus:py-2 font-mono text-sm"
      >Skip to content</a
    >
    <header class="w-full max-w-2xl mx-auto px-5 pt-8 pb-12 sm:pt-12 sm:pb-16">
      <nav class="flex items-baseline justify-between" aria-label="Main">
        <a
          href="/"
          class="font-mono text-sm font-medium tracking-tight hover:text-accent transition-colors"
          aria-label="Ramón Miklus – home"
          >rm<span class="text-accent" aria-hidden="true">_</span></a
        >
        <div class="flex gap-6 font-mono text-sm">
          <a
            href="/writing/"
            aria-current={current("/writing")}
            class="text-muted hover:text-accent transition-colors">writing</a
          >
          <a
            href="/about/"
            aria-current={current("/about")}
            class="text-muted hover:text-accent transition-colors">about</a
          >
          <button
            id="theme-toggle"
            type="button"
            hidden
            aria-label="Switch to dark mode"
            class="self-center text-muted hover:text-accent transition-colors cursor-pointer"
          >
            <svg
              class="block dark:hidden"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
            <svg
              class="hidden dark:block"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4" />
              <path
                d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32 1.41-1.41"
              />
            </svg>
          </button>
        </div>
      </nav>
    </header>

    <main id="main" class="flex-1 w-full max-w-2xl mx-auto px-5">
      <slot />
    </main>

    <footer
      class="w-full max-w-2xl mx-auto px-5 mt-20 sm:mt-28 py-8 border-t border-line"
    >
      <div
        class="flex flex-wrap items-baseline justify-between gap-3 font-mono text-xs text-muted"
      >
        <p>© {new Date().getFullYear()} Ramón Miklus</p>
        <div class="flex items-center gap-5">
          {
            social.map(({ label, href, icon }) => (
              <a
                href={href}
                class="hover:text-accent transition-colors"
                rel="me noopener"
                target="_blank"
                aria-label={`${label} (opens in new tab)`}
              >
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d={icon} />
                </svg>
              </a>
            ))
          }
          <a href="/rss.xml" class="hover:text-accent transition-colors">rss</a>
        </div>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      const button = document.getElementById("theme-toggle");
      if (button) {
        const relabel = () => {
          button.setAttribute(
            "aria-label",
            root.dataset.theme === "dark" ? "Switch to light mode" : "Switch to dark mode",
          );
        };
        button.addEventListener("click", () => {
          const next = root.dataset.theme === "dark" ? "light" : "dark";
          root.dataset.theme = next;
          try {
            localStorage.setItem("theme", next);
          } catch {}
          relabel();
        });
        matchMedia("(prefers-color-scheme: dark)").addEventListener("change", relabel);
        relabel();
        button.hidden = false;
      }
    </script>
  </body>
</html>

---
import "../styles/global.css";
import "@fontsource-variable/archivo";
import "@fontsource-variable/source-serif-4";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = "Ramón Miklus, software engineer. Notes from building software.",
} = Astro.props;

const social = [
  {
    label: "GitHub",
    href: "https://github.com/RaymondMik",
    icon: "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12",
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/ramon-miklus/",
    icon: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
  },
];

const pageTitle = title ? `${title} · Ramón Miklus` : "Ramón Miklus";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Ramón Miklus — Writing"
      href={new URL("rss.xml", Astro.site)}
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body
    class="bg-paper text-ink font-serif antialiased min-h-dvh flex flex-col"
  >
    <header class="w-full max-w-2xl mx-auto px-5 pt-8 pb-12 sm:pt-12 sm:pb-16">
      <nav class="flex items-baseline justify-between" aria-label="Main">
        <a
          href="/"
          class="font-mono text-sm font-medium tracking-tight hover:text-accent transition-colors"
          title="Ramón Miklus — home"
          >rm<span class="text-accent" aria-hidden="true">_</span></a
        >
        <div class="flex gap-6 font-mono text-sm">
          <a
            href="/writing/"
            class="text-muted hover:text-accent transition-colors">writing</a
          >
          <a
            href="/about/"
            class="text-muted hover:text-accent transition-colors">about</a
          >
        </div>
      </nav>
    </header>

    <main class="flex-1 w-full max-w-2xl mx-auto px-5">
      <slot />
    </main>

    <footer
      class="w-full max-w-2xl mx-auto px-5 mt-20 sm:mt-28 py-8 border-t border-line"
    >
      <div
        class="flex flex-wrap items-baseline justify-between gap-3 font-mono text-xs text-muted"
      >
        <p>© {new Date().getFullYear()} Ramón Miklus</p>
        <div class="flex items-center gap-5">
          {
            social.map(({ label, href, icon }) => (
              <a
                href={href}
                class="hover:text-accent transition-colors"
                rel="me noopener"
                target="_blank"
                aria-label={label}
                title={label}
              >
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d={icon} />
                </svg>
              </a>
            ))
          }
          <a href="/rss.xml" class="hover:text-accent transition-colors">rss</a>
        </div>
      </div>
      <p class="mt-3 font-mono text-xs text-muted/70">
        rm — like the command, except this one mostly creates things.
      </p>
    </footer>
  </body>
</html>

---
/**
 * NASA Astronomy Picture of the Day.
 * Fetched at build time, so it shows the picture from the day the site was last built.
 * NASA_API_KEY is a server-only secret declared in astro.config.mjs (env.schema);
 * it falls back to NASA's DEMO_KEY when unset.
 */
import { NASA_API_KEY } from 'astro:env/server';

interface Apod {
  title: string;
  date: string;
  explanation: string;
  media_type: 'image' | 'video' | string;
  url: string;
  hdurl?: string;
  thumbnail_url?: string;
  copyright?: string;
}

let apod: Apod | null = null;
try {
  const url = new URL('https://api.nasa.gov/planetary/apod');
  url.searchParams.set('api_key', NASA_API_KEY);
  url.searchParams.set('thumbs', 'true');
  const res = await fetch(url);
  if (res.ok) apod = (await res.json()) as Apod;
  else console.warn(`[apod] NASA API responded ${res.status}; skipping section`);
} catch (err) {
  // Log only the message — never the error object, which could carry the request URL (and key).
  console.warn(`[apod] failed to fetch NASA APOD; skipping section (${err instanceof Error ? err.message : 'unknown error'})`);
}

const isImage = apod?.media_type === 'image';
const imageSrc = isImage ? apod?.url : apod?.thumbnail_url;
const linkHref = isImage ? (apod?.hdurl ?? apod?.url) : apod?.url;
const apodPage = apod
  ? `https://apod.nasa.gov/apod/ap${apod.date.slice(2).replaceAll('-', '')}.html`
  : undefined;
const credit = apod?.copyright?.trim().replace(/\s+/g, ' ');
---

{
  apod && (
    <section class="mt-16 pt-10 border-t border-line" aria-labelledby="apod-heading">
      <h2 id="apod-heading" class="font-mono text-xs text-muted uppercase tracking-widest">
        Astronomy picture of the day
      </h2>

      <a href={linkHref} target="_blank" rel="noopener" class="group block mt-6">
        {imageSrc ? (
          <img
            src={imageSrc}
            alt={apod.title}
            loading="lazy"
            decoding="async"
            class="w-full rounded-lg border border-line group-hover:border-accent transition-colors"
          />
        ) : (
          <span class="block rounded-lg border border-line px-4 py-6 font-mono text-sm text-muted">
            Today's picture is a video — watch it on NASA's site →
          </span>
        )}
      </a>

      <h3 class="mt-4 font-display font-bold tracking-tight text-xl">
        <a href={apodPage} target="_blank" rel="noopener" class="hover:text-accent transition-colors">
          {apod.title}
        </a>
      </h3>
      <p class="mt-1 font-mono text-xs text-muted">
        <time datetime={apod.date}>{apod.date}</time>
        {credit && <span> · © {credit}</span>}
        <span> · via <a href="https://apod.nasa.gov/" target="_blank" rel="noopener" class="hover:text-accent transition-colors">NASA APOD</a></span>
      </p>

      <details class="mt-3 text-muted leading-relaxed">
        <summary class="cursor-pointer font-mono text-xs hover:text-accent transition-colors">
          What am I looking at?
        </summary>
        <p class="mt-2 max-w-prose">{apod.explanation}</p>
      </details>
    </section>
  )
}

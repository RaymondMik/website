---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PostRow from '../components/PostRow.astro';
import { readingTime } from '../utils/readingTime';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const [latest, ...rest] = posts;
const recent = rest.slice(0, 4);
---

<Layout>
  <section>
    <p class="font-mono text-sm text-accent mb-4">ramón miklus</p>
    <h1 class="font-display font-extrabold tracking-tight text-3xl sm:text-4xl leading-tight">
      Notes from building software.
    </h1>
    <p class="mt-6 text-lg leading-relaxed text-muted max-w-prose">
      Security, tooling, and the small decisions that turn out to matter.
    </p>
  </section>

  <section class="mt-16 sm:mt-20">
    <h2 class="font-mono text-xs text-muted uppercase tracking-widest mb-6">Latest writing</h2>

    {
      latest && (
        <a href={`/writing/${latest.id}/`} class="group block pb-8 border-b border-line">
          <h3 class="font-display font-bold tracking-tight text-2xl sm:text-3xl leading-tight group-hover:text-accent transition-colors">
            {latest.data.title}
          </h3>
          <p class="mt-3 text-muted leading-relaxed">{latest.data.description}</p>
          <span class="mt-3 block font-mono text-xs text-muted">{readingTime(latest)}</span>
        </a>
      )
    }

    {
      recent.length > 0 && (
        <ul class="divide-y divide-line">
          {recent.map((post) => (
            <PostRow post={post} />
          ))}
        </ul>
      )
    }

    <p class="mt-8">
      <a
        href="/writing/"
        class="font-mono text-sm text-accent hover:underline underline-offset-4"
      >all writing →</a>
    </p>
  </section>
</Layout>
